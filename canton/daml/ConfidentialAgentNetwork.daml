module ConfidentialAgentNetwork where

template Mandate
  with
    owner : Party
    agent : Party
    counterparty : Party
    assetId : Text
    maxAmountUnits : Int64
    maxTransactions : Int64
    transactionsUsed : Int64
    expiresAt : Time
  where
    signatory owner
    observer agent, counterparty
    ensure maxAmountUnits > 0 && maxTransactions > 0 && transactionsUsed >= 0 && transactionsUsed <= maxTransactions

    choice Propose : ContractId Proposal
      with
        proposerAgent : Party
        amountUnits : Int64
        nonce : Text
      controller owner
      do
        now <- getTime
        assertMsg "mandate expired" (now < expiresAt)
        assertMsg "amount must be positive" (amountUnits > 0)
        assertMsg "amount exceeds mandate limit" (amountUnits <= maxAmountUnits)
        assertMsg "proposal nonce required" (nonce /= "")
        proposal <- create Proposal with
          mandateId = self
          owner
          counterparty
          proposerAgent
          acceptorAgent = counterparty
          assetId
          amountUnits
          expiresAt
          nonce
        return proposal

    choice CommitAcceptance : ContractId Mandate
      with
        proposalNonce : Text
      controller owner, counterparty
      do
        now <- getTime
        assertMsg "mandate expired" (now < expiresAt)
        assertMsg "transaction limit reached" (transactionsUsed < maxTransactions)
        assertMsg "proposal nonce required" (proposalNonce /= "")
        create this with transactionsUsed = transactionsUsed + 1

template Proposal
  with
    mandateId : ContractId Mandate
    owner : Party
    counterparty : Party
    proposerAgent : Party
    acceptorAgent : Party
    assetId : Text
    amountUnits : Int64
    expiresAt : Time
    nonce : Text
  where
    signatory owner
    observer counterparty, proposerAgent, acceptorAgent

    choice Accept : ContractId SettlementAuthorization
      controller owner, counterparty
      do
        now <- getTime
        assertMsg "proposal expired" (now < expiresAt)
        updatedMandate <- exercise mandateId CommitAcceptance with proposalNonce = nonce
        create SettlementAuthorization with
          mandateId = updatedMandate
          proposalId = self
          owner
          counterparty
          proposerAgent
          acceptorAgent
          assetId
          amountUnits
          proposalNonce = nonce

template SettlementAuthorization
  with
    mandateId : ContractId Mandate
    proposalId : ContractId Proposal
    owner : Party
    counterparty : Party
    proposerAgent : Party
    acceptorAgent : Party
    assetId : Text
    amountUnits : Int64
    proposalNonce : Text
  where
    signatory owner, counterparty
    observer proposerAgent, acceptorAgent

    choice Cancel : ()
      controller owner, counterparty
      do return ()
