module ConfidentialAgentNetwork where

template Mandate
  with
    owner : Party
    agent : Party
    counterparty : Party
    assetId : Text
    maxAmountUnits : Int
    maxTransactions : Int
    transactionsUsed : Int
    expiresAt : Time
  where
    signatory owner
    observer agent, counterparty
    ensure maxAmountUnits > 0 && maxTransactions > 0 && transactionsUsed >= 0 && transactionsUsed <= maxTransactions

    nonconsuming choice Propose : ContractId Proposal
      with
        proposerAgent : Party
        amountUnits : Int
        nonce : Text
      controller owner
      do
        now <- getTime
        assertMsg "mandate expired" (now < expiresAt)
        assertMsg "amount must be positive" (amountUnits > 0)
        assertMsg "amount exceeds mandate limit" (amountUnits <= maxAmountUnits)
        assertMsg "transaction limit reached" (transactionsUsed < maxTransactions)
        assertMsg "proposal nonce required" (nonce /= "")
        assertMsg "proposer agent mismatch" (proposerAgent == agent)
        proposal <- create Proposal with
          mandateId = self
          owner
          counterparty
          proposerAgent
          acceptorAgent = counterparty
          assetId
          amountUnits
          expiresAt
          nonce
        return proposal

template Proposal
  with
    mandateId : ContractId Mandate
    owner : Party
    counterparty : Party
    proposerAgent : Party
    acceptorAgent : Party
    assetId : Text
    amountUnits : Int
    expiresAt : Time
    nonce : Text
  where
    signatory owner
    observer counterparty, proposerAgent, acceptorAgent

    choice Accept : ContractId SettlementAuthorization
      controller owner, counterparty
      do
        now <- getTime
        assertMsg "proposal expired" (now < expiresAt)
        assertMsg "proposal nonce required" (nonce /= "")
        mandate <- fetch mandateId
        assertMsg "mandate owner mismatch" (mandate.owner == owner)
        assertMsg "mandate counterparty mismatch" (mandate.counterparty == counterparty)
        assertMsg "mandate asset mismatch" (mandate.assetId == assetId)
        assertMsg "proposal expiry mismatch" (mandate.expiresAt == expiresAt)
        assertMsg "mandate amount limit changed" (amountUnits <= mandate.maxAmountUnits)
        assertMsg "mandate expired" (now < mandate.expiresAt)
        assertMsg "transaction limit reached" (mandate.transactionsUsed < mandate.maxTransactions)
        archive mandateId
        updatedMandate <- create mandate with transactionsUsed = mandate.transactionsUsed + 1
        create SettlementAuthorization with
          mandateId = updatedMandate
          proposalId = self
          owner
          counterparty
          proposerAgent
          acceptorAgent
          assetId
          amountUnits
          proposalNonce = nonce

template SettlementAuthorization
  with
    mandateId : ContractId Mandate
    proposalId : ContractId Proposal
    owner : Party
    counterparty : Party
    proposerAgent : Party
    acceptorAgent : Party
    assetId : Text
    amountUnits : Int
    proposalNonce : Text
  where
    signatory owner, counterparty
    observer proposerAgent, acceptorAgent

    choice Cancel : ()
      controller owner, counterparty
      do return ()
